# ==============================================================================
#  BORDER SURVEILLANCE SYSTEM - ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI INVESTIGATION ASSISTANT (GEMINI LLM) [RECOMMENDED]
# ------------------------------------------------------------------------------
# Required for natural language Q&A and auto-drafting forensic incident reports.
# If left blank, the system automatically falls back to grounded SQL query engine.
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY='Paste Your Gemini key here'
AI_MODEL=gemini-flash-latest


# ------------------------------------------------------------------------------
# 2. VIDEO SENSOR INPUT SETTINGS
# ------------------------------------------------------------------------------
# 0 = Primary Webcam, 1 = Secondary Webcam, or path to MP4 video / RTSP IP stream
# e.g., VIDEO_SOURCE=gettyimages-1215957003-640_adpp.mp4
# e.g., VIDEO_SOURCE=0 (for webcam)
VIDEO_SOURCE=15690486_1920_1080_25fps.mp4
FPS=25
USE_GPU=true
DETECTION_THRESHOLD=0.50

# ------------------------------------------------------------------------------
# 3. DATABASE & RETENTION
# ------------------------------------------------------------------------------
# SQLite is pre-configured and ready to use without external database servers.
# In enterprise deployment, you can switch to PostgreSQL: postgresql://user:pass@localhost:5432/db
DATABASE_URL=sqlite:///data/surveillance.db
EVIDENCE_RETENTION_DAYS=30

# ------------------------------------------------------------------------------
# 4. SERVER & NETWORK SETTINGS
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
DASHBOARD_ALERTS_ENABLED=true

# ------------------------------------------------------------------------------
# 5. BEHAVIOR & ANOMALY THRESHOLDS
# ------------------------------------------------------------------------------
# Time in seconds a person stays in an area before triggering a loitering alert
LOITERING_TIME=30
LOITERING_AREA=0.2
TAMPERING_SENSITIVITY=0.3
CRAWLING_RATIO=0.5
ALERT_COOLDOWN=5

# ------------------------------------------------------------------------------
# 6. RISK SCORING ENGINE WEIGHTS (Total = 100)
# ------------------------------------------------------------------------------
RISK_WEIGHT_INTRUSION=40.0
RISK_WEIGHT_LOITERING=20.0
RISK_WEIGHT_ABANDONED=15.0
RISK_WEIGHT_BASELINE_ZSCORE=25.0

# ------------------------------------------------------------------------------
# 7. BANDWIDTH-AWARE SYNC LAYER (INNOVATION 2)
# ------------------------------------------------------------------------------
SYNC_COMMAND_URL=http://localhost:8080
SYNC_CHECK_INTERVAL_SECONDS=30